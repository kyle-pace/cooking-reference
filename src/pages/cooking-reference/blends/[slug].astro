---
// One blend, paste or sauce: what it is, amounts, method, how it varies, make or buy, and uses.
import LabLayout from 'kp-design/layouts/LabLayout.astro';
import Sections from '../../../components/Sections.astro';
import Further from '../../../components/Further.astro';
import { blends, type Blend } from '../../../data/foundations';
import { pairable } from '../../../lib/pairable';
import '../../../styles/theme.css';
import '../../../styles/foundation.css';

export function getStaticPaths() {
  return blends.map((b) => ({ params: { slug: b.slug }, props: { b } }));
}
const { b } = Astro.props as { b: Blend };
// The name as it reads mid-sentence: without its aside, and lower case unless it starts with a place.
const plain = b.name.replace(/, .*| \(.*/, '');
const lower = /^(Chinese|Thai|Sichuan|Chesapeake|Cajun)/.test(plain) ? plain : plain.charAt(0).toLowerCase() + plain.slice(1);
// The blend itself first, when the pairings know it, then what's in it.
const goesWith = pairable([{ name: lower, id: b.id }, ...b.amounts.map((a) => a.ingredient)]);
// What the amounts are of, when the list doesn't say.
const AMOUNTS_NOTE = { dry: 'Whole spices unless it says ground.', herbs: '', paste: '', sauce: '' };
---

<LabLayout
  lab={{ name: 'Cooking reference', href: '/cooking-reference/' }}
  about="/cooking-reference/about/"
  title={`${b.name}: how to make it`}
  description={b.summary}
  image="/cooking-reference/og.png"
  imageAlt="Cooking reference: flavor pairings, ratios and spice blends. A lab on kylepace.dev."
  themeColor={{ light: '#f2f5f1', dark: '#131917' }}
>
  <article class="lab-page foundation" data-foundation={b.slug}>
    <h1 class="title">{b.name}</h1>
    <Sections current="blends" />

    <section aria-labelledby="what-h">
      <h2 id="what-h" class="sr">What it is</h2>
      <p class="summary">{b.summary}</p>
      {b.about.map((t) => <p>{t}</p>)}
      <p>More about <a href={b.cuisine.href} data-out-link="world-cuisine">{b.cuisine.name}</a> cooking on World cuisine.</p>
    </section>

    <section aria-labelledby="amounts-h">
      <h2 id="amounts-h">Amounts</h2>
      <p>Makes {b.makes}. {AMOUNTS_NOTE[b.form]}</p>
      <ul class="ruled blend-amounts">
        {
          b.amounts.map((a) => (
            <li>
              <span class="amt num">{a.amount}</span>
              <span>
                {a.ingredient.name}
                {a.note && <small>{a.note}</small>}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="method-h">
      <h2 id="method-h">Method</h2>
      <ol class="method">{b.method.map((t) => <li>{t}</li>)}</ol>
    </section>

    <section aria-labelledby="varies-h">
      <h2 id="varies-h">How it varies</h2>
      {b.varies.map((t) => <p>{t}</p>)}
    </section>

    <section aria-labelledby="buy-h">
      <h2 id="buy-h">Make it or buy it</h2>
      {b.makeOrBuy.map((t) => <p>{t}</p>)}
    </section>

    <section aria-labelledby="uses-h">
      <h2 id="uses-h">Ways to use it</h2>
      <ul class="uses">{b.uses.map((t) => <li>{t}</li>)}</ul>
    </section>

    <Further
      foundation={b.slug}
      ingredients={goesWith}
      findish={{ label: `Find recipes with ${lower} on Findish`, query: b.id ? `with=${b.id}` : `q=${encodeURIComponent(plain)}` }}
      reading={b.reading}
    />
  </article>
</LabLayout>

<script>
  import '../../../scripts/links';
</script>
