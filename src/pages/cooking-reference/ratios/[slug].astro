---
// One ratio: the ratio in big type, a bar split into its parts, a calculator, then why it
// works, the method, swaps from other cuisines and where to go next. A ratio can have any
// number of parts, by volume or by weight; the arithmetic is in src/lib/ratio.ts.
import LabLayout from 'kp-design/layouts/LabLayout.astro';
import Sections from '../../../components/Sections.astro';
import Further from '../../../components/Further.astro';
import { ratios, type Ratio } from '../../../data/foundations';
import { UNITS, toBase, fraction } from '../../../lib/amounts';
import { perText, said, work, type Calc } from '../../../lib/ratio';
import { pairable } from '../../../lib/pairable';
import '../../../styles/theme.css';
import '../../../styles/foundation.css';

export function getStaticPaths() {
  return ratios.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}
const { r } = Astro.props as { r: Ratio };
const calc: Calc = {
  slug: r.slug,
  measure: r.measure,
  show: r.show ?? 'parts',
  parts: r.parts.map(({ key, name, per, gPerTsp, liquid, each }) => ({ key, name, per, gPerTsp, liquid, each })),
  extras: r.extras.map(({ name, amount, unit, per, of, note }) => ({ name, amount, unit, per, of, note })),
  makes: r.makes,
  saidFixed: Boolean(r.said),
};
const pers = r.parts.map((p) => p.per);
const ranged = r.parts.find((p) => p.range);
const presets = r.adjust?.presets ?? [];
// The amounts shown before the calculator's script runs: the ratio's own starting amount.
const startUnit = UNITS[r.measure].find((u) => u.value === r.start.unit)!;
const first = work(calc, pers, toBase(r.start.amount, r.start.unit), r.start.of);
const startOf = r.parts.find((p) => p.key === r.start.of)!;
const cuisines = r.swaps.filter((s) => s.cuisine);
const percent = r.show === 'percent';
---

<LabLayout
  lab={{ name: 'Cooking reference', href: '/cooking-reference/' }}
  about="/cooking-reference/about/"
  title={`${r.name} ratio`}
  description={r.summary}
  image="/cooking-reference/og.png"
  imageAlt="Cooking reference: flavor pairings, ratios and spice blends. A lab on kylepace.dev."
  themeColor={{ light: '#f2f5f1', dark: '#131917' }}
>
  <article class="lab-page foundation">
    <h1 class="title">{r.name}</h1>
    <Sections current="ratios" />

    <section class="ratio" aria-labelledby="ratio-h" data-ratio={JSON.stringify(calc)}>
      <h2 id="ratio-h" class="sr">The ratio</h2>
      <p class="lead">{r.summary}</p>
      <p class:list={['big', 'num', { long: r.parts.length > 3 }]}>
        <span class="figure">
          {
            percent ? (
              <><span data-per={r.parts[1].key}>{r.parts[1].per}</span>%</>
            ) : (
              r.parts.map((p, i) => (
                <>{i > 0 && <span class="colon"> : </span>}<span data-per={p.key}>{perText(p.per)}</span></>
              ))
            )
          }
        </span>
        <span class="said" data-said>{r.said ?? said(calc)}</span>
      </p>
      <div class="bar-parts" aria-hidden="true" data-bar>
        {r.parts.map((p) => <span class="part" data-part={p.key} style={`flex-grow:${p.per}`}><span>{p.name}</span></span>)}
      </div>
    </section>

    <section class="calc" aria-labelledby="calc-h">
      <h2 id="calc-h">Amounts</h2>
      <div class="controls" data-controls hidden>
        <div class="have">
          <label for="amount">I have</label>
          <input id="amount" type="number" inputmode="decimal" min="0" step="any" value={r.start.amount} />
          <label class="sr" for="unit">Unit</label>
          <select id="unit">
            {UNITS[r.measure].map((u) => <option value={u.value} selected={u.value === r.start.unit}>{u.label}</option>)}
          </select>
          <label class="sr" for="of">Of</label>
          <span aria-hidden="true">of</span>
          <select id="of">
            {r.parts.map((p) => <option value={p.key} selected={p.key === r.start.of}>{p.name}</option>)}
          </select>
        </div>
        {
          ranged && r.adjust && (
            <div class="strength">
              {presets.length > 0 && (
                <div class="preset">
                  <label for="preset">Make it for</label>
                  <select id="preset">
                    {presets.map((s) => <option value={s.per} selected={s.per === ranged.per}>{s.name}</option>)}
                    <option value="" selected={!presets.some((s) => s.per === ranged.per)}>My own setting</option>
                  </select>
                </div>
              )}
              <label for="per">
                {r.adjust.label}: <output id="per-out" for="per" class="num">{perText(ranged.per)}</output>
              </label>
              <input id="per" type="range" min={ranged.range![0]} max={ranged.range![1]} step={ranged.step ?? 0.5} value={ranged.per} data-key={ranged.key} />
              <p class="hint">{r.adjust.hint}</p>
            </div>
          )
        }
      </div>
      <p class="for" data-for>For {startUnit.value === 'cup' ? `${fraction(r.start.amount)} ${r.start.amount > 1 ? 'cups' : 'cup'}` : `${r.start.amount.toLocaleString('en-US')} ${startUnit.label}`} of {startOf.name}:</p>
      <ul class="ruled amounts" data-out aria-live="polite">
        {first.rows.map((row) => <li><span>{row.name}</span><span class="num">{row.text}</span></li>)}
      </ul>
      <p class="makes" data-makes>{first.makes}</p>
      {r.note && <p class="note">{r.note}</p>}
      {
        presets.length > 0 && ranged && (
          <p class="note" data-presets-said>
            {r.adjust!.label}: {presets.map((s, i) => `${perText(s.per)} for ${s.name.charAt(0).toLowerCase()}${s.name.slice(1)}${i < presets.length - 1 ? '; ' : '.'}`)}
          </p>
        )
      }
    </section>

    <section aria-labelledby="why-h">
      <h2 id="why-h">Why it works</h2>
      {r.why.map((t) => <p>{t}</p>)}
    </section>

    <section aria-labelledby="method-h">
      <h2 id="method-h">Method</h2>
      <ol class="method">{r.method.map((t) => <li>{t}</li>)}</ol>
    </section>

    <section aria-labelledby="swaps-h">
      <h2 id="swaps-h">Make it yours</h2>
      <p>Keep the ratio and change what fills it.</p>
      <div class="table-wrap" role="region" aria-labelledby="swaps-h" tabindex="0">
        <table class="swaps">
          <thead>
            <tr>
              <td></td>
              {r.swaps.map((s) => <th scope="col">{s.style}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              r.swapRows.map((row, i) => (
                <tr>
                  <th scope="row">{row}</th>
                  {r.swaps.map((s) => <td>{s.values[i]}</td>)}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      {
        cuisines.length > 0 && (
          <p class="cuisines">
            More about {cuisines.length === 1 ? 'this cuisine' : 'these cuisines'} on World cuisine:{' '}
            {cuisines.map((s, i, all) => (
              <>
                <a href={s.cuisine!.href} data-out-link="world-cuisine">{s.cuisine!.name}</a>{i < all.length - 2 ? ', ' : i === all.length - 2 ? ' and ' : '.'}
              </>
            ))}
          </p>
        )
      }
    </section>

    <section aria-labelledby="related-h">
      <h2 id="related-h">Related</h2>
      <ul class="ruled">
        {r.related.map((x) => <li><h3>{x.href ? <a href={x.href}>{x.name}</a> : x.name}</h3><p>{x.note}</p></li>)}
      </ul>
    </section>

    <Further foundation={r.slug} ingredients={pairable([...r.parts.map((p) => p.ingredient), ...r.extras.map((e) => e.ingredient)])} findish={r.findish} reading={r.reading} />
  </article>
</LabLayout>

<script>
  import '../../../scripts/ratio';
</script>
